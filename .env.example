NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Em produção, aponte para o domínio real (ex: https://www.laranegociosimobiliarios.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envio de e-mail (convite de admin e outras notificações), via Resend.
# RESEND_API_KEY: gerada em https://resend.com/api-keys.
# EMAIL_FROM: precisa usar um domínio verificado (SPF/DKIM) no Resend,
# ex: "LARA Negócios Imobiliários <no-reply@laranegociosimobiliarios.com.br>".
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: "true" faz o site rodar inteiro com dados fictícios em memória
# (sem Supabase), útil pra navegar/testar antes de ter um projeto real.
# Deixe "false" (ou remova a linha) em produção.
NEXT_PUBLIC_MOCK_MODE=false
